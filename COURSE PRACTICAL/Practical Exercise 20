#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>
#define N 5
sem_t fork[N];
void *philosopher(void *arg)
{
    int id = *(int *)arg;
    printf("Philosopher %d is thinking\n", id);
    sem_wait(&fork[id]);
    sem_wait(&fork[(id + 1) % N]);
    printf("Philosopher %d is eating\n", id);
    sleep(1);
    sem_post(&fork[(id + 1) % N]);
    sem_post(&fork[id]);
    printf("Philosopher %d finished eating\n", id);
    return NULL;
}
int main()
{
    pthread_t p[N];
    int id[N];
    int i;
    for(i = 0; i < N; i++)
        sem_init(&fork[i], 0, 1);
    for(i = 0; i < N; i++) {
        id[i] = i;
        pthread_create(&p[i], NULL, philosopher, &id[i]);
    }
    for(i = 0; i < N; i++)
        pthread_join(p[i], NULL);

    for(i = 0; i < N; i++)
        sem_destroy(&fork[i]);
    return 0;
}
