#include <stdio.h>
int main() {
    int records[50];
    int n, i, key, found = 0;
    printf("Enter number of records: ");
    scanf("%d", &n);
    printf("Enter records:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &records[i]);
    printf("\nRecords stored sequentially:\n");
    for(i = 0; i < n; i++)
        printf("Record %d = %d\n", i + 1, records[i]);
    printf("\nEnter record to search: ");
    scanf("%d", &key);
    printf("\nReading records sequentially:\n");
    for(i = 0; i < n; i++) {
        printf("Reading Record %d: %d\n", i + 1, records[i]);
        if(records[i] == key) {
            printf("Record found at position %d\n", i + 1);
            found = 1;
            break;
        }
    }
    if(!found)
        printf("Record not found\n");
    return 0;
}
