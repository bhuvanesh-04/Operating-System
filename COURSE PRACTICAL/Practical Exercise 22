#include <stdio.h>
#include <string.h>
struct User {
    char name[20];
    char files[20][30];
    int count;
};
int main() {
    struct User users[10];
    int ucount = 0;
    int choice, i, j, found;
    char username[20], filename[30];
    while (1) {
        printf("\n1. Create User");
        printf("\n2. Create File");
        printf("\n3. Display Files");
        printf("\n4. Search File");
        printf("\n5. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);
        switch (choice) {
        case 1:
            printf("Enter username: ");
            scanf("%s", username);
            strcpy(users[ucount].name, username);
            users[ucount].count = 0;
            ucount++;
            printf("User created successfully\n");
            break;
        case 2:
            printf("Enter username: ");
            scanf("%s", username);
            found = 0;
            for (i = 0; i < ucount; i++) {
                if (strcmp(users[i].name, username) == 0) {
                    printf("Enter filename: ");
                    scanf("%s", filename);
                    strcpy(users[i].files[users[i].count], filename);
                    users[i].count++;
                    printf("File created successfully\n");
                    found = 1;
                    break;
                }
            }
            if (!found)
                printf("User not found\n");
            break;
        case 3:
            printf("Enter username: ");
            scanf("%s", username);
            found = 0;
            for (i = 0; i < ucount; i++) {
                if (strcmp(users[i].name, username) == 0) {
                    printf("\nFiles of %s:\n", username);
                    for (j = 0; j < users[i].count; j++)
                        printf("%s\n", users[i].files[j]);
                    found = 1;
                    break;
                }
            }
            if (!found)
                printf("User not found\n");
            break;
        case 4:
            printf("Enter username: ");
            scanf("%s", username);
            printf("Enter filename: ");
            scanf("%s", filename);
            found = 0;
            for (i = 0; i < ucount; i++) {
                if (strcmp(users[i].name, username) == 0) {

                    for (j = 0; j < users[i].count; j++) {
                        if (strcmp(users[i].files[j], filename) == 0) {
                            printf("File found\n");
                            found = 1;
                            break;
                        }
                    }
                }
            }
            if (!found)
                printf("File not found\n");
            break;
        case 5:
            return 0;
        default:
            printf("Invalid choice\n");
        }
    }
}
