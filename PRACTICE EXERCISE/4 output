#include <stdio.h>
int main(void) {
    int processes[] = {1, 2, 3, 4};
    int n = sizeof(processes) / sizeof(processes[0]);
    printf("Simple FCFS Scheduler Simulation:\n");
    for (int i = 0; i < n; i++) {
        printf("Running Process P%d\n", processes[i]);
    }
    printf("All processes completed.\n");
    return 0;
}
