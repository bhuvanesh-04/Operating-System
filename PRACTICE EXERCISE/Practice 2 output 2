#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
int main() {
    pid_t pid;
    int status;
    pid = fork();
    if (pid < 0) {
        perror("Fork failed");
        return 1;
    } 
    else if (pid == 0) {
        printf("Child Process: My PID is %d\n", getpid());
        printf("Child Process: Doing some work...\n");
        sleep(2);
        printf("Child Process: Terminating now.\n");
        exit(42); 
    } 
    else {
        printf("Parent Process: My PID is %d\n", getpid());
        printf("Parent Process: Waiting for the child process to finish...\n");
        pid_t terminated_child_pid = wait(&status);
        printf("Parent Process: Child with PID %d has terminated.\n", terminated_child_pid);
        if (WIFEXITED(status)) {
            int exit_code = WEXITSTATUS(status);
            printf("Parent Process: Child exited normally with code: %d\n", exit_code);
        } else {
            printf("Parent Process: Child terminated abnormally.\n");
        }
    }
    return 0;
}
