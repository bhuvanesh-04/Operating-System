#include <stdio.h>
#define MAX 5
int queue[MAX];
int front = -1, rear = -1;
void enqueue(int x) {
    if (rear == MAX - 1) {
        printf("Queue Full\n");
        return;
    }
    if (front == -1) front = 0;
    queue[++rear] = x;
}
int dequeue() {
    if (front == -1 || front > rear) {
        printf("Queue Empty\n");
        return -1;
    }
    return queue[front++];
}
int main(void) {
    enqueue(101);  // Process IDs
    enqueue(102);
    enqueue(103);
    printf("Executing process %d\n", dequeue());
    printf("Executing process %d\n", dequeue());
    printf("Executing process %d\n", dequeue());
    return 0;
}
