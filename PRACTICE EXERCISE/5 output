#include <stdio.h>
int main(void) {
    FILE *fp = fopen("/tmp/test.txt", "w");
    if (fp == NULL) {
        perror("fopen");
        return 1;
    }
    fprintf(fp, "Hello, OS Lab!\n");
    fclose(fp);
    fp = fopen("/tmp/test.txt", "r");
    if (fp == NULL) {
        perror("fopen");
        return 1;
    }
    int ch;
    while ((ch = fgetc(fp)) != EOF)
        putchar(ch);
    fclose(fp);
    return 0;
}
