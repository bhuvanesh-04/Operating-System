#include <stdio.h>
#define SIZE 5
int buffer[SIZE];
int front = 0, rear = 0, count = 0;
void produce(int item) {
    if (count == SIZE) {
        printf("Buffer Full\n");
        return;
    }
    buffer[rear] = item;
    rear = (rear + 1) % SIZE;
    count++;
}
int consume(void) {
    if (count == 0) {
        printf("Buffer Empty\n");
        return -1;
    }
    int item = buffer[front];
    front = (front + 1) % SIZE;
    count--;
    return item;
}
int main(void) {
    produce(10);
    produce(20);
    printf("Consumed: %d\n", consume());
    printf("Consumed: %d\n", consume());

    return 0;
}
