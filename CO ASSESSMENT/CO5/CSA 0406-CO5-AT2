BEGIN
 SET threshold = 80
SET usage = GET_DISK_USAGE()  
 IF usage > threshold THEN
 SET log_files = GET_LOG_FILES()
 SORT log_files BY size DESCENDING
FOR EACH file IN log_files DO
 COMPRESS_OR_DELETE(file)
 usage = GET_DISK_USAGE()
  IF usage <= threshold THEN
   BREAK
 ENDIF
ENDFOR
ENDIF
END
2Q)
BEGIN
INPUT process_list
SORT process_list BY priority DESCENDING
WHILE process_list IS NOT EMPTY DO
SET current_process = REMOVE_FIRST(process_list)
ALLOCATE_CPU(current_process)
EXECUTE(current_process)
IF current_process.is_completed == FALSE THEN
  DECREASE_PRIORITY(current_process)
  REINSERT_BY_PRIORITY(process_list, current_process)
    ENDIF
    ENDWHILE
END
