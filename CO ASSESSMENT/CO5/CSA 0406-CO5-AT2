BEGIN
SET total_RAM = 16GB
SET host_reserved = 4GB
SET available_RAM = total_RAM - host_reserved
SET min_RAM_per_VM = 2GB
INPUT number_of_VMs
 FOR i = 1 TO number_of_VMs DO
IF available_RAM >= min_RAM_per_VM THEN
ALLOCATE_RAM(VM[i], min_RAM_per_VM)
available_RAM = available_RAM - min_RAM_per_VM
PRINT "Successfully allocated " + min_RAM_per_VM + " to VM " + i
ELSE
PRINT "Error: Insufficient RAM for VM " + i
ENDIF
    ENDFOR
END
4Q)
BEGIN
INPUT performance_required, budget, direct_hardware_access
IF performance_required == HIGH AND direct_hardware_access == TRUE THEN
SET selected_hypervisor = "Type 1 (Bare-Metal Hypervisor)"
SET justification = "Provides low latency, direct hardware control, and high performance."
    ELSE IF budget == LOW THEN
SET selected_hypervisor = "Type 2 (Hosted Hypervisor)"
SET justification = "Lower cost, runs on top of existing OS, simple to set up."
    ELSE
SET selected_hypervisor = "Type 1 (Bare-Metal Hypervisor)"
SET justification = "Ensures optimal resource utilization and stability."
    ENDIF
    PRINT selected_hypervisor
    PRINT justification
END
