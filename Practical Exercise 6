#include<stdio.h>

int main()
{
    int n,i,time=0,completed=0,min,pid;
    int at[20],bt[20],rt[20],pr[20],ct[20],wt[20],tat[20];

    printf("Enter number of processes: ");
    scanf("%d",&n);

    for(i=0;i<n;i++)
    {
        printf("AT BT Priority: ");
        scanf("%d%d%d",&at[i],&bt[i],&pr[i]);
        rt[i]=bt[i];
    }

    while(completed<n)
    {
        min=999;
        pid=-1;

        for(i=0;i<n;i++)
        {
            if(at[i]<=time && rt[i]>0 && pr[i]<min)
            {
                min=pr[i];
                pid=i;
            }
        }

        if(pid==-1)
        {
            time++;
            continue;
        }

        rt[pid]--;
        time++;

        if(rt[pid]==0)
        {
            completed++;
            ct[pid]=time;
            tat[pid]=ct[pid]-at[pid];
            wt[pid]=tat[pid]-bt[pid];
        }
    }

    printf("\nP\tAT\tBT\tPR\tWT\tTAT\n");

    for(i=0;i<n;i++)
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n",
        i+1,at[i],bt[i],pr[i],wt[i],tat[i]);

    return 0;
}
