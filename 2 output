#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main(void) {
    pid_t pid1 = fork();

    if (pid1 == 0) {
        printf("First child PID: %d\n", getpid());
        return 0;
    }

    pid_t pid2 = fork();

    if (pid2 == 0) {
        printf("Second child PID: %d\n", getpid());
        return 0;
    }

    wait(NULL);
    wait(NULL);

    return 0;
}
